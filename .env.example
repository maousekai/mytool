# Vietnamese TTS Dataset Builder runtime options

# Express/Vite web server port (default: 3000)
PORT=3000

# Maximum size of each uploaded file in bytes.
# Default in server.ts is 2147483648 (2 GiB).
MAX_UPLOAD_BYTES=2147483648

# Web mode intentionally restricts output folders to this project directory.
# Set to 1 only for a trusted local deployment if absolute output paths are required.
ALLOW_ABSOLUTE_OUTPUT_DIRS=0

# Optional explicit FFmpeg/FFprobe executables for the Python local engine.
# FFMPEG_PATH=C:\\ffmpeg\\bin\\ffmpeg.exe
# FFPROBE_PATH=C:\\ffmpeg\\bin\\ffprobe.exe
